      case 0x03: // FSUB Sd = Sn - Sm\\n3123\\t            return new FSubS(machInst, rd, rn, rm);\\n3124\\t          case 0x13: // FSUB Dd = Dn - Dm\\n3125\\t            return new FSubD(machInst, rd, rn, rm);\\n3126\\t          case 0x33: // FSUB Hd = Hn - Hm\\n3127\\t            return new FSubH(machInst, rd, rn, rm);\\n3128\\t          case 0x04: // FMAX Sd = max(Sn, Sm)\\n3129\\t            return new FMaxS(machInst, rd, rn, rm);\\n3130\\t          case 0x14: // FMAX Dd = max(Dn, Dm)\\n3131\\t            return new FMaxD(machInst, rd, rn, rm);\\n3132\\t          case 0x34: // FMAX Hd = max(Hn, Hm)\\n3133\\t            return new FMaxH(machInst, rd, rn, rm);\\n3134\\t          case 0x05: // FMIN Sd = min(Sn, Sm)\\n3135\\t            return new FMinS(machInst, rd, rn, rm);\\n3136\\t          case 0x15: // FMIN Dd = min(Dn, Dm)\\n3137\\t            return new FMinD(machInst, rd, rn, rm);\\n3138\\t          case 0x35: // FMIN Hd = min(Hn, Hm)\\n3139\\t            return new FMinH(machInst, rd, rn, rm);\\n3140\\t          case 0x06: // FMAXNM Sd = maxNum(Sn, Sm)\\n3141\\t            return new FMaxNMS(machInst, rd, rn, rm);\\n3142\\t          case 0x16: // FMAXNM Dd = maxNum(Dn, Dm)\\n3143\\t            return new FMaxNMD(machInst, rd, rn, rm);\\n3144\\t          case 0x36: // FMAXNM Hd = maxNum(Hn, Hm)\\n3145\\t            return new FMaxNMH(machInst, rd, rn, rm);\\n3146\\t          case 0x07: // FMINNM Sd = minNum(Sn, Sm)\\n3147\\t            return new FMinNMS(machInst, rd, rn, rm);\\n3148\\t          case 0x17: // FMINNM Dd = minNum(Dn, Dm)\\n3149\\t            return new FMinNMD(machInst, rd, rn, rm);\\n3150\\t          case 0x37: // FMINNM Hd = minNum(Hn, Hm)\\n3151\\t            return new FMinNMH(machInst, rd, rn, rm);\\n3152\\t          case 0x08: // FNMUL Sd = -(Sn * Sm)\\n3153\\t            return new FNMulS(machInst, rd, rn, rm);\\n3154\\t          case 0x18: // FNMUL Dd = -(Dn * Dm)\\n3155\\t            return new FNMulD(machInst, rd, rn, rm);\\n3156\\t