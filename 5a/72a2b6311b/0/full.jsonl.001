egIndex ra    = (RegIndex)(uint32_t)bits(machInst, 14, 10);\\n2996\\t        uint8_t switchVal = (bits(machInst, 23, 21) << 1) |\\n2997\\t                            (bits(machInst, 15)     << 0);\\n2998\\t        switch (switchVal) {\\n2999\\t          case 0x0: // FMADD Sd = Sa + Sn*Sm\\n3000\\t            return new FMAddS(machInst, rd, rn, rm, ra);\\n3001\\t          case 0x1: // FMSUB Sd = Sa + (-Sn)*Sm\\n3002\\t            return new FMSubS(machInst, rd, rn, rm, ra);\\n3003\\t          case 0x2: // FNMADD Sd = (-Sa) + (-Sn)*Sm\\n3004\\t            return new FNMAddS(machInst, rd, rn, rm, ra);\\n3005\\t          case 0x3: // FNMSUB Sd = (-Sa) + Sn*Sm\\n3006\\t            return new FNMSubS(machInst, rd, rn, rm, ra);\\n3007\\t          case 0x4: // FMADD Dd = Da + Dn*Dm\\n3008\\t            return new FMAddD(machInst, rd, rn, rm, ra);\\n3009\\t          case 0x5: // FMSUB Dd = Da + (-Dn)*Dm\\n3010\\t            return new FMSubD(machInst, rd, rn, rm, ra);\\n3011\\t          case 0x6: // FNMADD Dd = (-Da) + (-Dn)*Dm\\n3012\\t            return new FNMAddD(machInst, rd, rn, rm, ra);\\n3013\\t          case 0x7: // FNMSUB Dd = (-Da) + Dn*Dm\\n3014\\t            return new FNMSubD(machInst, rd, rn, rm, ra);\\n3015\\t          case 0xc: // FMADD Hd = Ha + Hn*Hm\\n3016\\t            return new FMAddH(machInst, rd, rn, rm, ra);\\n3017\\t          case 0xd: // FMSUB Hd = Ha + (-Hn)*Hm\\n3018\\t            return new FMSubH(machInst, rd, rn, rm, ra);\\n3019\\t          case 0xe: // FNMADD Hd = (-Ha) + (-Hn)*Hm\\n3020\\t            return new FNMAddH(machInst, rd, rn, rm, ra);\\n3021\\t          case 0xf: // FNMSUB Hd = (-Ha) + Hn*Hm\\n3022\\t            return new FNMSubH(machInst, rd, rn, rm, ra);\\n3023\\t          default:\\n3024\\t            return new Unknown64(machInst);\\n3025\\t        }\\n3026\\t    }\\n3027\\t\\n3028\\t    StaticInstPtr\\n3029\\t    decodeFpCondSel(ExtMachInst machInst)\\n3030\\t    {\\n3031\\t        if (bits(machInst, 31) || bits(machInst, 29))\\n3032\\t            return new Unknown64(machInst);\\n3033\\t        uint8_t type = bits(machInst, 23, 22);\\n3034\\t        RegIndex rd = (RegIndex)(uint32_t)bits(machInst,  4,  0);\\n3035\\t        RegIndex rn = (RegIndex)(uint32_t)bits(machInst,  9,  5);\\n3036\\t        RegIndex rm = (RegIndex)(uint32_t)bits(machInst, 20, 16);\\n3037\\t        ConditionCode cond =\\n3038\\t            (ConditionCode)(uint8_t)(bits(machInst, 15, 12));\\n3039\\t        if (type == 0) // FCSEL Sd = if cond then Sn else Sm\\n3040\\t            return new FCSelS(machInst, rd, rn, rm, cond);\\n3041\\t        else if (type == 1) // FCSEL Dd = if cond then Dn else Dm\\n3042\\t            return new FCSelD(machInst, rd, rn, rm, cond);\\n3043\\t        else if (type == 3) // FCSEL Hd = if cond then Hn else Hm\\n3044\\t            return new FCSelH(machInst, rd, rn, rm, cond);\\n3045\\t        else\\n3046\\t            return new Unknown64(machInst);\\n3047\\t    }\\n3048\\t\\n3049\\t    StaticInstPtr\\n3050\\t    decodeFpCondCompare(ExtMachInst machInst)\\n3051\\t    {\\n3052\\t        if (bits(machInst, 31) ||\\n3053\\t            bits(machInst, 29)) {\\n3054\\t            return new Unknown64(machInst);\\n3055\\t        }\\n3056\\t        RegIndex rm = (RegIndex)(uint32_t) bits(machInst, 20, 16);\\n3057\\t        RegIndex rn = (RegIndex)(uint32_t) bits(machInst, 9, 5);\\n3058\\t        uint8_t    imm = (RegIndex)(uint32_t) bits(machInst, 3, 0);\\n3059\\t        ConditionCode cond =\\n3060\\t            (ConditionCode)(uint8_t)(bits(machInst, 15, 12));\\n3061\\t        uint8_t switchVal = (bits(machInst, 4) << 0) |\\n3062\\t                            (bits(machInst, 23, 22) << 1);\\n3063\\t        // 31:23=000111100, 21=1, 11:10=01\\n3064\\t        switch (switchVal) {\\n3065\\t          case 0x0:\\n3066\\t            // FCCMP flags = if cond the compareQuiet(Sn,Sm) else #nzcv\\n3067\\t            return new FCCmpRegS(machInst, rn, rm, cond, imm);\\n3068\\t          case 0x1:\\n306