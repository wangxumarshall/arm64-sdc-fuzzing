21=1, bit15=0\\n3701\\t    // These are reserved in scalar FP space; they are actually AdvSIMD\\n3702\\t    // scalar three-same.  Catch them before isFpDataProc2Source.\\n3703\\t    inline constexpr auto isFpMulMadd = bitPatternMatcher<\\n3704\\t        MachInst,\\n3705\\t        31, 10,\\n3706\\t        '0','0','0','1', // op0: bits31:28=0001\\n3707\\t        '1','X','X',\\n3708\\t        '0','0',         // op1: bits27=1, bits26:25=XX (11 for FMLS/FMLA),\\n3709\\t                         //       bit24=0, bit23=0\\n3710\\t        '0','X','X','X', // op2: bit22=0, bits21:20=XX\\n3711\\t        'X','X','X','X', // op3: bits19:16=XXXX\\n3712\\t        'X','X','X','X','X'>(); // op3: bits15:10=XXXXX\\n3713\\t\\n3714\\t    inline constexpr auto isFpDataProc1Source = bitPatternMatcher<\\n3715\\t        MachInst,\\n3716\\t        31, 10,\\n3717\\t        'X','0','X','1', // op0\\n3718\\t        '1','1','1',\\n3719\\t        '0','X', // op1\\n3720\\t        '1','X','X','X', // op2: bit22=1 (excludes FMLA/FMLS which have bit22=0)\\n3721\\t        'X','X','X','X','1','0','0','0','0'>(); // op3\\n3722\\t\\n3723\\t    inline constexpr auto isFpCompare = bitPatternMatcher<\\n3724\\t        MachInst,\\n3725\\t        31, 10,\\n3726\\t        'X','0','X','1', // op0\\n3727\\t        '1','1','1',\\n3728\\t        '0','X', // op1\\n3729\\t        'X','1','X','X', // op2\\n3730\\t        'X','X','X','X','X','1','0','0','0'>(); // op3\\n3731\\t\\n3732\\t    inline constexpr auto isFpImmediate = bitPatternMatcher<\\n3733\\t        MachInst,\\n3734\\t        31, 10,\\n3735\\t        'X','0','X','1', // op0\\n3736\\t        '1','1','1',\\n3737\\t        '0','X', // op1\\n3738\\t        'X','1','X','X', // op2\\n3739\\t        'X','X','X','X','X','X','1','0','0'>(); // op3\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augme