       return new EorsRegPclr(machInst, rd,\\n850\\t                                                                                               rn, rm, imm5,\\n851\\t                                                                                               type);\\n852\\t                                                          } else\\n853\\t                                           {\\n854\\t                                                              return new EorRegCc(machInst, rd,\\n855\\t                                                                                            rn, rm, imm5, type);\\n856\\t                                                          }\\n857\\t                                                      } else {\\n858\\t                                                          return new EorReg(machInst, rd, rn,\\n859\\t                                                                                       rm, imm5, type);\\n860\\t                                                      }\\n861\\t                                                  } else {\\n862\\t                                                      if (setCc) {\\n863\\t                                                          return new EorRegRegCc(machInst, rd,\\n864\\t                                                                                            rn, rm, rs, type);\\n865\\t                                                      } else {\\n866\\t                                                          return new EorRegReg(machInst, rd,\\n867\\t                                                                                          rn, rm, rs, type);\\n868\\t                                                      }\\n869\\t                                                  }\\n870\\t                                                  break;\\n871\\t                                          \\n872\\t                                                case 0x2:\\n