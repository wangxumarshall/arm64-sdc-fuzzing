 20, 16);\\n82197\\t\\n82198\\t        // opcode & 1: 0=FMLS, 1=FMLA\\n82199\\t        // For FMLS only 16-bit elements are valid; 32/64-bit return Unknown.\\n82200\\t        switch (size) {\\n82201\\t          case 0: // 16-bit elements (half-precision)\\n82202\\t            if (opcode & 1) { // FMLA\\n82203\\t                if (q)\\n82204\\t                    return new FmlaQX<uint16_t>(machInst, vd, vn, vm);\\n82205\\t                else\\n82206\\t                    return new FmlaDX<uint16_t>(machInst, vd, vn, vm);\\n82207\\t            } else { // FMLS\\n82208\\t                if (q)\\n82209\\t                    return new FmlsQX<uint16_t>(machInst, vd, vn, vm);\\n82210\\t                else\\n82211\\t                    return new FmlsDX<uint16_t>(machInst, vd, vn, vm);\\n82212\\t            }\\n82213\\t          case 1: // 32-bit elements (single-precision)\\n82214\\t            // FMLS is not defined for single-precision scalar; only FMLA.\\n82215\\t            if (opcode & 1) { // FMLA\\n82216\\t                if (q)\\n82217\\t                    return new FmlaQX<uint32_t>(machInst, vd, vn, vm);\\n82218\\t                else\\n82219\\t                    return new FmlaDX<uint32_t>(machInst, vd, vn, vm);\\n82220\\t            }\\n82221\\t            return new Unknown64(machInst);\\n82222\\t          default:\\n82223\\t            return new Unknown64(machInst);\\n82224\\t        }\\n82225\\t    }\\n82226\\t\\n82227\\t    StaticInstPtr\\n82228\\t    decodeNeon3SameFp16(ExtMachInst machInst)\\n82229\\t    {\\n82230\\t        uint8_t u_a_opcode = bits(machInst, 29) << 4 | // u\\n82231\\t                             bits(machInst, 23) << 3 | // a\\n82232\\t                             bits(machInst, 13, 11);   // opcode\\n82233\\t\\n82234\\t        RegIndex vd = (RegIndex) (uint8_t) bits(machInst, 4, 0);\\n82235\\t        RegIndex vn = (RegIndex) (uint8_t) bits(machInst, 9, 5);\\n82236\\t        RegIndex vm = (RegIndex) (uint8_t) bits(machInst, 20, 1