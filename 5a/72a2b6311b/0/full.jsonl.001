hey are actually AdvSIMD\\n    // scalar three-same.  Catch them before isFpDataProc2Source.\\n    inline constexpr auto isFpMulMadd = bitPatternMatcher<\\n        MachInst,\\n        31, 10,\\n        '0','0','0','1', // op0: bits31:28=0001\\n        '1','1','1',\\n        '0','0',         // op1: bits27:24=0110 (bit24=0 already enforced)\\n        '0','X','X','X', // op2: bit23=0, bits22:20=XXX\\n        'X','X','X','X', // op3: bits19:16=XXXX\\n        'X','X','X','X','X'>(); // op3: bits15:10=XXXXX\",\"new_string\":\"    // FMLA/FMLS: 31:24=00011110, 23:22=00, 21=1, bit15=0\\n    // These are reserved in scalar FP space; they are actually AdvSIMD\\n    // scalar three-same.  Catch them before isFpDataProc2Source.\\n    inline constexpr auto isFpMulMadd = bitPatternMatcher<\\n        MachInst,\\n        31, 10,\\n        '0','0','0','1', // op0: bits31:28=0001\\n        '1','X','X',\\n        'X','0',         // op1: bits27:25=XXX (bit25=1 for FMLS/FMLA),\\n                         //       bit24=X (0 for FMLS/FMLA), bit23=0\\n        '0','X','X','X', // op2: bit23=0, bits22:20=XXX\\n        'X','X','X','X', // op3: bits19:16=XXXX\\n        'X','X','X','X','X'>(); // op3: bits15:10=XXXXX\"}}],\"model\":\"MiniMax-M2.7\",\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"usage\":{\"input_tokens\":287,\"cache_creation_input_tokens\":1145,\"cache_read_input_tokens\":80157,\"output_tokens\":1052,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":0,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"\",\"iterations\":[],\"speed\":\"standard\"},\"service_tier\":\"standard\"},\"type\":\"assistant\",\"uuid\":\"9c19c3a4-8962-4f83-bc9d-138aa4d913ba\",\"timestamp\":\"2026-04-02T04:11:48.195Z\",\"userType\":\"external\",\"entrypoint\":\"cli\",\"cwd\":\"/Users/wangxu/1-project/sdc-fuzzing/gem5\",\"sessionId\":\"d910793e-44d5-4b76-a978-fb98052552f1\",\"version\":\"2.1.87\",