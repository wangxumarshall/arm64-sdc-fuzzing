bits(machInst, 20, 15);\\n3265\\t\\n3266\\t        RegIndex rn = (RegIndex)(uint32_t)bits(machInst, 9, 5);\\n3267\\t        RegIndex rd = (RegIndex)(uint32_t)bits(machInst, 4, 0);\\n3268\\t\\n3269\\t        // Bits 31:24=00011110, 21=1, 14:10=10000\\n3270\\t        switch (opcode) {\\n3271\\t          case 0x0:\\n3272\\t            if (type == 0)\\n3273\\t                // FMOV Sd = Sn\\n3274\\t                return new FmovRegS(machInst, rd, rn);\\n3275\\t            else if (type == 1)\\n3276\\t                // FMOV Dd = Dn\\n3277\\t                return new FmovRegD(machInst, rd, rn);\\n3278\\t            else if (type == 3)\\n3279\\t                // FMOV Hd = Hn\\n3280\\t                return new FmovRegH(machInst, rd, rn);\\n3281\\t            break;\\n3282\\t          case 0x1:\\n3283\\t            if (type == 0)\\n3284\\t                // FABS Sd = abs(Sn)\\n3285\\t                return new FAbsS(machInst, rd, rn);\\n3286\\t            else if (type == 1)\\n3287\\t                // FABS Dd = abs(Dn)\\n3288\\t                return new FAbsD(machInst, rd, rn);\\n3289\\t            else if (type == 3)\\n3290\\t                // FABS Hd = abs(Hn)\\n3291\\t                return new FAbsH(machInst, rd, rn);\\n3292\\t            break;\\n3293\\t          case 0x2:\\n3294\\t            if (type == 0)\\n3295\\t                // FNEG Sd = -Sn\\n3296\\t                return new FNegS(machInst, rd, rn);\\n3297\\t            else if (type == 1)\\n3298\\t                // FNEG Dd = -Dn\\n3299\\t                return new FNegD(machInst, rd, rn);\\n3300\\t            else if (type == 3)\\n3301\\t                // FNEG Hd = -Hn\\n3302\\t                return new FNegH(machInst, rd, rn);\\n3303\\t            break;\\n3304\\t          case 0x3:\\n3305\\t            if (type == 0)\\n3306\\t                // FSQRT Sd = sqrt(Sn)\\n3307\\t                return new FSqrtS(machInst, rd, rn);\\n3308\\t            else if (type == 1)\\n3309\\t                // FS