urn new PLDW_LOAD_IMM_PN_AY_WN_SN_UN_SZ1(machInst, int_reg::Zero,\\nL78[depth=13]:                                                                                rn, add, imm12);\\nL79[depth=13]:                                                   } else {\\nL80[depth=13]:                                                       return new PLDW_LOAD_IMM_PN_AN_WN_SN_UN_SZ1(machInst, int_reg::Zero,\\nL81[depth=13]:                                                                                rn, add, imm12);\\nL82[depth=12]:                                                   }\\nL83[depth=12]:                                               } else {\\nL84[depth=13]:                                                   if (add) {\\nL85[depth=13]:                                                       return new PLD_LOAD_IMM_PN_AY_WN_SN_UN_SZ1(machInst, int_reg::Zero,\\nL86[depth=13]:                                                                               rn, add, imm12);\\nL87[depth=13]:                                                   } else {\\nL88[depth=13]:                                                       return new PLD_LOAD_IMM_PN_AN_WN_SN_UN_SZ1(machInst, int_reg::Zero,\\nL89[depth=13]:                                                                               rn, add, imm12);\\nL90[depth=12]:                                                   }\\nL91[depth=11]:                                               }\\nL92[depth=11]:                                           } else if (op1 == 0x57) {\\nL93[depth=12]:                                               switch (op2) {\\nL94[depth=12]:                                                 case 0x1:\\nL95[depth=12]:                                                   return new Clrex(machInst);\\nL96[depth=12]:                                                 case 0x4:\\nL97[depth=12]:                                                   return new Dsb(machInst, 0);\\nL98[depth=12]:                                         