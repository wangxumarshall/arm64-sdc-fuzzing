destElem = letoh(destReg.elements[i]);'\\n109\\t\\n110\\t        if complex:\\n111\\t            eWalkCode += op\\n112\\t        elif pairwise:\\n113\\t            eWalkCode += '''\\n114\\t        for (unsigned i = 0; i < eCount; i++) {\\n115\\t            Element srcElem1 = letoh(2 * i < eCount ?\\n116\\t                                     srcReg1.elements[2 * i] :\\n117\\t                                     srcReg2.elements[2 * i - eCount]);\\n118\\t            Element srcElem2 = letoh(2 * i < eCount ?\\n119\\t                                     srcReg1.elements[2 * i + 1] :\\n120\\t                                     srcReg2.elements[2 * i + 1 - eCount]);\\n121\\t            Element destElem;\\n122\\t            %(readDest)s\\n123\\t            %(op)s\\n124\\t            destReg.elements[i] = htole(destElem);\\n125\\t        }\\n126\\t        ''' % { \\\"op\\\" : op, \\\"readDest\\\" : readDestCode }\\n127\\t        else:\\n128\\t            if nepSrc:\\n129\\t                scalarCheck = '''\\n130\\t            if (i != 0) {\\n131\\t                if (!((FPCR)Fpcr).nep) {\\n132\\t                    destReg.elements[i] = 0;\\n133\\t                }\\n134\\t                continue;\\n135\\t            }\\n136\\t            '''\\n137\\t            else:\\n138\\t                scalarCheck = '''\\n139\\t            if (i != 0) {\\n140\\t                destReg.elements[i] = 0;\\n141\\t                continue;\\n142\\t            }\\n143\\t            '''\\n144\\t            eWalkCode += extra\\n145\\t            eWalkCode += '''\\n146\\t        for (unsigned i = 0; i < eCount; i++) {\\n147\\t            %(scalarCheck)s\\n148\\t            Element srcElem1 = letoh(srcReg1.elements[i]);\\n149\\t            Element srcElem2 = letoh(srcReg2.elements[%(src2Index)s]);\\n150\\t            Element destElem;\\n151\\t            %(readDest)s\\n152\\t            %(op)s\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be consider