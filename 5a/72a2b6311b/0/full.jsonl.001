rn decodeNeonAcrossLanes(machInst);\\n82156\\t        if (isAdvSIMD3Diff(machInst)) return decodeNeon3Diff(machInst);\\n82157\\t        if (isAdvSIMD3Same(machInst)) return decodeNeon3Same<DecoderFeatures>(machInst);\\n82158\\t        if (isAdvSIMDModImm(machInst)) return decodeNeonModImm(machInst);\\n82159\\t        if (isAdvSIMDShiftByImm(machInst)) return decodeNeonShiftByImm(machInst);\\n82160\\t        if (isAdvSIMDIndexedElem(machInst)) return decodeNeonIndexedElem<DecoderFeatures>(machInst);\\n82161\\t        if (isConvFloatPFixedP(machInst)) return decodeFpConvFixed(machInst);\\n82162\\t        if (isConvFloatPInt(machInst)) return decodeFpConvFp(machInst);\\n82163\\t        if (isFpMulMadd(machInst)) return decodeFpMulMadd(machInst);\\n82164\\t        if (isFpDataProc1Source(machInst)) return decodeFpDataProc1Source(machInst);\\n82165\\t        if (isFpCompare(machInst)) return decodeFpCompare(machInst);\\n82166\\t        if (isFpImmediate(machInst)) return decodeFpImmediate(machInst);\\n82167\\t        if (isFpCondCompare(machInst)) return decodeFpCondCompare(machInst);\\n82168\\t        if (isFpDataProc2Source(machInst)) return decodeFpDataProc2Source(machInst);\\n82169\\t        if (isFpCondSel(machInst)) return decodeFpCondSel(machInst);\\n82170\\t        if (isFpDataProc(machInst)) return decodeFpDataProc(machInst);\\n82171\\t\\n82172\\t        return new Unknown64(machInst);\\n82173\\t    }\\n82174\\t}\\n82175\\t\\n82176\\tnamespace Aarch64\\n82177\\t{\\n82178\\ttemplate StaticInstPtr decodeFpAdvSIMD<GenericDecoder>(ExtMachInst machInst);\\n82179\\t\\n82180\\t}\\n82181\\tnamespace Aarch64\\n82182\\t{\\n82183\\t    // FMLA/FMLS: 31:24=00011110, 23:22=00, 21=1, bit15=0, opcode in bits14:10\\n82184\\t    // These are reserved in scalar FP space but are valid AdvSIMD scalar\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you