turn new FNegS(machInst, rd, rn);\\n3297\\t            else if (type == 1)\\n3298\\t                // FNEG Dd = -Dn\\n3299\\t                return new FNegD(machInst, rd, rn);\\n3300\\t            else if (type == 3)\\n3301\\t                // FNEG Hd = -Hn\\n3302\\t                return new FNegH(machInst, rd, rn);\\n3303\\t            break;\\n3304\\t          case 0x3:\\n3305\\t            if (type == 0)\\n3306\\t                // FSQRT Sd = sqrt(Sn)\\n3307\\t                return new FSqrtS(machInst, rd, rn);\\n3308\\t            else if (type == 1)\\n3309\\t                // FSQRT Dd = sqrt(Dn)\\n3310\\t                return new FSqrtD(machInst, rd, rn);\\n3311\\t            else if (type == 3)\\n3312\\t                // FSQRT Hd = sqrt(Hn)\\n3313\\t                return new FSqrtH(machInst, rd, rn);\\n3314\\t            break;\\n3315\\t          case 0x4:\\n3316\\t            if (type == 1)\\n3317\\t                // FCVT Sd = convertFormat(Dn)\\n3318\\t                return new FcvtFpDFpS(machInst, rd, rn);\\n3319\\t            else if (type == 3)\\n3320\\t                // FCVT Sd = convertFormat(Hn)\\n3321\\t                return new FcvtFpHFpS(machInst, rd, rn);\\n3322\\t            break;\\n3323\\t          case 0x5:\\n3324\\t            if (type == 0)\\n3325\\t                // FCVT Dd = convertFormat(Sn)\\n3326\\t                return new FCvtFpSFpD(machInst, rd, rn);\\n3327\\t            else if (type == 3)\\n3328\\t                // FCVT Dd = convertFormat(Hn)\\n3329\\t                return new FcvtFpHFpD(machInst, rd, rn);\\n3330\\t            break;\\n3331\\t          case 0x6:\\n3332\\t            if (type == 1)\\n3333\\t                // FCVT Hd = convertFormat(Sn)\\n3334\\t                return new FcvtFpSBf(machInst, rd, rn);\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to imp