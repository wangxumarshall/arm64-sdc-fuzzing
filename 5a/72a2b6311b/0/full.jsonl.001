 } else {\\n2888\\t                                          if ((bits(machInst, 25) == 0x0) &&                         (bits(machInst, 31) == 0x1)) {\\n2889\\t                                              // bit 31:25=1xx0000\\n2890\\t                                              return decodeSmeInst(machInst);\\n2891\\t                                          } else {\\n2892\\t                                              return new Unknown64(machInst);\\n2893\\t                                          }\\n2894\\t                                      }\\n2895\\t                                  } else if (bits(machInst, 26) == 0)\\n2896\\t                                      // bit 28:26=100\\n2897\\t                                      return decodeDataProcImm(machInst);\\n2898\\t                                  else\\n2899\\t                                      // bit 28:26=101\\n2900\\t                                      return decodeBranchExcSys(*this, machInst);\\n2901\\t                              } else if (bits(machInst, 25) == 0) {\\n2902\\t                                  // bit 27=1, 25=0\\n2903\\t                                  return decodeLoadsStores(machInst);\\n2904\\t                              } else if (bits(machInst, 26) == 0) {\\n2905\\t                                  // bit 27:25=101\\n2906\\t                                  return decodeDataProcReg(machInst);\\n2907\\t                              } else if (bits(machInst, 24) == 1 &&\\n2908\\t                                         bits(machInst, 31, 28) == 0xF) {\\n2909\\t                                  return new Gem5Op64(machInst);\\n2910\\t                              } else {\\n2911\\t                                  // bit 27:25=111\\n2912\\t                                  switch(decoderFlavor){\\n2913\\t                                  default:\\n2914\\t                                      return decodeFpAdvSIMD<GenericDecoder>(machInst);\\n2915\\t         