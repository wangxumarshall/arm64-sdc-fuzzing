er {{\\n104\\tnamespace Aarch64\\n105\\t{\\n106\\t    // FMLA/FMLS: 31:24=00011110, 23:22=00, 21=1, 15=1, opcode in bits14:10\\n107\\t    // Encoding matches AdvSIMD scalar three-same; dispatch through\\n108\\t    // decodeNeonUThreeFpReg using the same (opcode, size, q) tuple.\\n109\\t    StaticInstPtr\\n110\\t    decodeFpMulMadd(ExtMachInst machInst)\\n111\\t    {\\n112\\t        uint8_t q     = bits(machInst, 30);\\n113\\t        uint8_t size  = bits(machInst, 23, 22);\\n114\\t\\n115\\t        RegIndex vd = (RegIndex)(uint8_t)bits(machInst, 4, 0);\\n116\\t        RegIndex vn = (RegIndex)(uint8_t)bits(machInst, 9, 5);\\n117\\t        RegIndex vm = (RegIndex)(uint8_t)bits(machInst, 20, 16);\\n118\\t\\n119\\t        // opcode: 0x19=FMLA, 0x1B=FMLS (bit14=1 for both, bits13:11 vary)\\n120\\t        // size selects element width: 0=16b, 1=32b, 2=64b\\n121\\t        switch (size) {\\n122\\t          case 0: // 16-bit elements (half-precision)\\n123\\t            if (q)\\n124\\t                return new FmlaQX<uint16_t>(machInst, vd, vn, vm);\\n125\\t            else\\n126\\t                return new FmlaDX<uint16_t>(machInst, vd, vn, vm);\\n127\\t          case 1: // 32-bit elements (single-precision)\\n128\\t            if (q)\\n129\\t                return new FmlaQX<uint32_t>(machInst, vd, vn, vm);\\n130\\t            else\\n131\\t                return new FmlaDX<uint32_t>(machInst, vd, vn, vm);\\n132\\t          case 2: // 64-bit elements (double-precision)\\n133\\t            if (q)\\n134\\t                return new FmlaQX<uint64_t>(machInst, vd, vn, vm);\\n135\\t            else\\n136\\t                return new FmlaDX<uint64_t>(machInst, vd, vn, vm);\\n137\\t          default:\\n138\\t            return new Unknown64(machInst);\\n139\\t        }\\n140\\t    }\\n141\\t\\n142\\t    StaticInstPtr\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it